<?xml version="1.0" encoding="utf-8"?>
<!-- Beatland launcher icon — background layer. Palette inspired by the reference bottle-cap
     photo: deep navy in the shadowed grooves, brightening to a vivid royal blue and then a clean
     sky blue on the lit highlights. Overrides drawable/ic_launcher_background.xml (the stock
     green Android-template placeholder) for the beatland flavor only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#0B1B4D" />
                <item android:offset="0.5" android:color="#1E4FBF" />
                <item android:offset="1.0" android:color="#6FA8F5" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
